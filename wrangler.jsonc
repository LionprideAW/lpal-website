{
  "name": "lpal-website",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Pages go through the worker first, so the old domain and www can forward to lpal.eu.
    // Images, styles and scripts under /assets are served directly (no worker request used).
    "run_worker_first": ["/*", "!/assets/*"]
  },
  // Qualifier registrations (LPAL Qualifier presented by TitanGrip)
  "d1_databases": [
    { "binding": "DB", "database_name": "lpal-qualifier", "database_id": "41adb3f9-7287-491e-8afa-c19ff911ccd6" }
  ],
  "routes": [
    { "pattern": "lionpride-armwrestling.com", "custom_domain": true },
    { "pattern": "www.lionpride-armwrestling.com", "custom_domain": true },
    { "pattern": "lpal.eu", "custom_domain": true },
    { "pattern": "www.lpal.eu", "custom_domain": true }
  ]
}
